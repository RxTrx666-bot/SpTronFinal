# =============================================================================
# TRON Wallet Funding Bot — configuration template (placeholders only)
# Copy to .env (chmod 600) or, better, provide secrets via *_FILE variables.
# NEVER commit a real .env file.
# =============================================================================

# ---- Mother Wallet (REQUIRED, SECRET) ----------------------------------------
# 64 hex chars. Prefer MOTHER_PRIVATE_KEY_FILE=/run/secrets/mother_private_key
# (file must be chmod 600). The key is never logged or displayed; only the
# derived address is printed at startup.
MOTHER_PRIVATE_KEY=
# MOTHER_PRIVATE_KEY_FILE=

# ---- Network -----------------------------------------------------------------
# mainnet (production) | nile (testnet, for testing without real funds)
TRON_NETWORK=mainnet
# Full node HTTP API base URL, e.g. https://api.trongrid.io (mainnet) or
# https://nile.trongrid.io (Nile testnet), or your own java-tron node.
TRON_RPC_URL=
# Optional separate solidity node URL (defaults to TRON_RPC_URL)
TRON_SOLIDITY_URL=
# Provider API key (SECRET). Sent as a header only, never in the URL.
TRON_API_KEY=
TRON_API_KEY_HEADER=TRON-PRO-API-KEY
# Only if you know what you are doing (the default is the genesis of TRON_NETWORK)
EXPECTED_GENESIS_BLOCK_ID=

# ---- USDT TRC-20 --------------------------------------------------------------
# Verify the address on https://tronscan.org before use. At startup the bot
# checks it is a contract, reports 6 decimals and symbol USDT, and (on mainnet)
# that it equals the official Tether USDT contract; anything else is refused
# unless USDT_ALLOW_NONSTANDARD_CONTRACT=true.
USDT_CONTRACT_ADDRESS=
USDT_ALLOW_NONSTANDARD_CONTRACT=false

# ---- Funding amounts (decimal, up to 6 places; 0 disables that asset) ---------
TRX_FUNDING_AMOUNT=5
USDT_FUNDING_AMOUNT=10
# Hard caps: runtime changes (/set_trx, admin API) can never exceed these
MAX_TRX_PER_WALLET=100
MAX_USDT_PER_WALLET=1000
# Rolling 24h spend limits (0 = unlimited). Reaching one fails + auto-pauses.
DAILY_TRX_LIMIT=0
DAILY_USDT_LIMIT=0
# Max TRX burned for energy per USDT transfer (fee_limit)
USDT_FEE_LIMIT_TRX=30
# Extra TRX kept for bandwidth / new-account activation per funding
TRX_FEE_BUFFER_TRX=2
# TRX that must always stay in the Mother Wallet
MIN_MOTHER_TRX_RESERVE=0
# Allow funding the same address again (also requires "repeat": true per request)
ALLOW_REPEAT_FUNDING=false
# Refuse destinations that are smart contracts (recommended)
ALLOW_CONTRACT_DESTINATIONS=false
AUTO_PAUSE_ON_INSUFFICIENT_BALANCE=true

# ---- Safety / modes ------------------------------------------------------------
# DRY_RUN=true: validate, build and sign locally, but NEVER broadcast
DRY_RUN=true
START_PAUSED=false

# ---- Queue ------------------------------------------------------------------
QUEUE_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
MAX_AUTO_RETRIES=5
RETRY_BASE_DELAY_MS=30000
INSTANCE_LEASE_TTL_SECONDS=30

# ---- Transactions -----------------------------------------------------------
TX_EXPIRATION_SECONDS=90
EXPIRY_SAFETY_MARGIN_SECONDS=60
CONFIRMATION_TIMEOUT_SECONDS=240
CONFIRMATION_POLL_MS=3000

# ---- RPC transport ------------------------------------------------------------
RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=3
RPC_MIN_INTERVAL_MS=0

# ---- HTTP API -----------------------------------------------------------------
API_ENABLED=true
# Keep 127.0.0.1 and put an HTTPS reverse proxy in front (see docs/DEPLOYMENT.md),
# or set TLS_CERT_FILE / TLS_KEY_FILE to serve HTTPS directly.
API_HOST=127.0.0.1
API_PORT=8080
TLS_CERT_FILE=
TLS_KEY_FILE=
# Set to the proxy address(es) when behind a reverse proxy, e.g. 127.0.0.1
TRUST_PROXY=
# Bearer keys (SECRET, >= 32 chars, must differ): openssl rand -hex 32
INTERNAL_API_KEY=
ADMIN_API_KEY=
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
API_MAX_BATCH_SIZE=100

# ---- Target wallet private keys ------------------------------------------------
# Funding an address does NOT need its private key.
#   discard (default): validate key matches address, then drop it (never stored)
#   reject:            refuse any request that contains a private key
#   encrypt:           store AES-256-GCM encrypted (only if a later feature needs it)
TARGET_PRIVATE_KEY_POLICY=discard
# 32 random bytes, base64 (SECRET): openssl rand -base64 32
TARGET_KEY_ENCRYPTION_KEY=

# ---- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids that receive alerts and may send commands
TELEGRAM_CHAT_ID=
# Optional: only these Telegram user ids may run commands
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_COMMANDS_ENABLED=true

# ---- Database -----------------------------------------------------------------
# sqlite:./data/funding.db   or   postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:./data/funding.db

# ---- Logging ------------------------------------------------------------------
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
# Optional file (in addition to stdout); rotate with deploy/logrotate
LOG_FILE=

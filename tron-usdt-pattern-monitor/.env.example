# ============================================================================
# TRON USDT TRC-20 test-transfer pattern monitor  -  configuration
# Copy to .env and fill in.  NEVER commit .env.  This system is READ-ONLY:
# it needs no private keys, seed phrases or wallet access - do not add any.
# ============================================================================

# ---------------------------------------------------------------- TRON API
TRON_API_URL=https://api.trongrid.io
# Free key: https://www.trongrid.io  (strongly recommended - without a key
# TronGrid rate-limits hard and backfill will be very slow)
TRON_API_KEY=

# USDT TRC-20 contract.  TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t is the OFFICIAL
# Tether USDT contract on TRON mainnet.  Change only if you know why.
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---------------------------------------------------------------- Database
# Docker Compose: only POSTGRES_PASSWORD is needed (DATABASE_URL is set by
# docker-compose.yml).  Use letters/digits only so it is URL-safe.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Native / systemd install:
DATABASE_URL=postgresql+asyncpg://tron:change-me-to-a-long-random-password@localhost:5432/tron_usdt

# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=
# One ID, or several separated by commas: alerts go to every chat listed.
# Each person must open the bot and press Start once before it can message them.
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true

# ---------------------------------------------------------------- Collector
POLL_INTERVAL_SECONDS=1
# Early alerting from not-yet-solidified blocks (stored as UNCONFIRMED)
ENABLE_UNCONFIRMED=true
UNCONFIRMED_POLL_INTERVAL_SECONDS=1
SEND_CONFIRMATION_ALERTS=false

# ---------------------------------------------------------------- Backfill
# History scanned on FIRST start to discover existing patterns.
# USDT on TRON has ~2-3 million transfers/day: 30 days is tens of millions of
# rows and ~hundreds of thousands of API calls.  See README "Sizing".
INITIAL_HISTORY_DAYS=30
BACKFILL_WINDOW_SECONDS=300
BACKFILL_CONCURRENCY=3

# ------------------------------------------------ Behavioural pattern rules
# None of these is a test-AMOUNT threshold. Test amounts are learned per
# Sender -> Recipient relationship.
MIN_SUCCESSFUL_SEQUENCES=3
# A follow-up must be >= this many times larger than the preceding transfer
# of the same pair to count as "substantially larger".
MIN_LARGE_TO_TEST_RATIO=10
# A transfer only counts as the LARGE side of a pattern if it is at least this many USDT
MIN_LARGE_AMOUNT_USDT=5000
MAX_FOLLOWUP_HOURS=168
MIN_PATTERN_CONFIDENCE=HIGH
MIN_SUCCESS_RATE=0.5
PATTERN_HALF_LIFE_DAYS=30
PATTERN_LOOKBACK_DAYS=120
PATTERN_EXPIRY_DAYS=60
# Relative matching band around each relationship's learned test range
TEST_MATCH_FACTOR=2.0
# Sub-cent noise floor (address-poisoning dust). NOT a test range.
DUST_FLOOR_USDT=0.01

# ---------------------------------------------------------------- Alerts
ALERT_MAX_TX_AGE_MINUTES=60
FLOOD_MAX_TESTS_PER_HOUR=6
NOTIFY_NEW_PATTERNS=true
SEND_STARTUP_MESSAGE=true
# e.g. Asia/Shanghai to show "UTC+8"
DISPLAY_TIMEZONE=UTC

# ---------------------------------------------------------------- Operations
RETENTION_DAYS=150
ANALYSIS_WORKERS=2
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

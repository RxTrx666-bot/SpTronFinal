# --- required -------------------------------------------------------------
# sent as TRON-PRO-API-KEY
TRON_API_KEY=your-trongrid-api-key
TELEGRAM_BOT_TOKEN=123456789:replace-me
# comma-separated for several chats
TELEGRAM_CHAT_ID=-1001234567890

# --- target ---------------------------------------------------------------
WALLET_ADDRESS=TWkvffFDMsqbmTLkMHMABmw452Hyq98cdn
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# --- filter (decimal strings, converted to integer base units) ------------
AMOUNTS=1.01,10,20,30
AMOUNT_TOLERANCE=0.000100

# --- polling --------------------------------------------------------------
POLL_INTERVAL_SECONDS=2
# every scan re-reads this window before the cursor
LOOKBACK_SECONDS=120
# first start only: how far back to begin
INITIAL_BACKFILL_SECONDS=0
# fast = /wallet (in block), solidified = /walletsolidity (~1 min later, final)
CONFIRMATION_MODE=fast
# drop candidates still not in a block after this long
VERIFY_MAX_AGE_SECONDS=3600
MAX_PAGES_PER_POLL=25
PAGE_LIMIT=200

# --- runtime --------------------------------------------------------------
DB_PATH=data/outflow_alert.db
LOG_LEVEL=INFO
HEARTBEAT_FILE=
# TRONGRID_BASE_URL=https://api.trongrid.io
# HTTP_TIMEOUT_SECONDS=10

# =====================================================================
# TRON USDT Monitor - configuration. Copy to .env and fill in secrets.
# Never commit .env.
# =====================================================================

# ---- TRON API -------------------------------------------------------
# TronGrid (recommended): https://api.trongrid.io + API key from trongrid.io
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
# Header name for the key. TronGrid uses TRON-PRO-API-KEY. For providers that put
# the key in the URL (QuickNode, GetBlock...), leave TRON_API_KEY empty and put
# the full endpoint URL in TRON_API_URL.
TRON_API_KEY_HEADER=TRON-PRO-API-KEY
TRON_REQUEST_TIMEOUT=10
TRON_MAX_RETRIES=4

# ---- Telegram -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---- What to monitor -----------------------------------------------
WALLET_ADDRESS=TWkvffFDMsqbmTLkMHMABmw452Hyq98cdn

# Official Tether USDT TRC-20 contract on TRON mainnet.
# The bot verifies on startup (on-chain symbol()/decimals()) that this is USDT/6.
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Inclusive range, max 6 decimals. Compared as integers (no floating point).
MIN_USDT=1.000000
MAX_USDT=1.200000

# ---- Monitoring -----------------------------------------------------
# account = poll TronGrid's indexed TRC-20 transfers of the wallet (needs TronGrid /v1 API).
# blocks  = scan every block's receipts and decode Transfer events (any java-tron full node).
MONITOR_MODE=account
POLL_INTERVAL_SECONDS=2
# false = alert as soon as the tx is in a block (fastest, ~3s).
# true  = only solidified/irreversible blocks (~1 minute slower).
CONFIRMED_ONLY=false
# account mode: confirm each match against the on-chain Transfer event log.
VERIFY_EVENT_LOG=true
VERIFY_TIMEOUT_SECONDS=60
# account mode: overlap window re-checked every poll so late-indexed txs are not missed.
LOOKBACK_SECONDS=120
MAX_PAGES_PER_POLL=20
# blocks mode tuning
MAX_BLOCKS_PER_POLL=60
BLOCK_FETCH_CONCURRENCY=3
VERIFY_CONTRACT_ON_STARTUP=true

# ---- Historical transactions (first start only) ---------------------
BACKFILL_ENABLED=false
BACKFILL_LIMIT=100
BACKFILL_MAX_PAGES=50

# ---- Misc ------------------------------------------------------------
# IANA timezone for an extra local-time line in alerts (UTC = no extra line)
TIMEZONE=UTC
DATABASE_URL=sqlite:///data/monitor.db
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
NOTIFY_ON_STARTUP=true
HEARTBEAT_FILE=data/heartbeat

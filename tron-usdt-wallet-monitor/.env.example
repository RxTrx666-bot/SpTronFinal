# =============================================================================
# TRON USDT TRC-20 wallet monitor - configuration.  Copy to .env and fill in.
# NEVER commit .env.  This system is READ-ONLY: it needs no private keys.
# =============================================================================

# ------------------------------------------------------------------ TRON API
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=YOUR_API_KEY
# Global API limits shared by every component (stream, scheduler, backfill)
MAX_CONCURRENT_API_REQUESTS=5
MAX_REQUESTS_PER_SECOND=10

# ------------------------------------------------------------------ Target
ROOT_WALLET=YOUR_WALLET_ADDRESS
# Official Tether USDT on TRON mainnet is TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t.
# The monitor verifies symbol()/decimals() at startup and warns if this differs.
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_DECIMALS=6

# ------------------------------------------------------------------ Rules
# Alert when a discovered wallet receives >= this amount (inclusive, exact decimals)
ALERT_MIN_AMOUNT_USDT=500
# 1 = only Wallet A's direct recipients are monitored (no recursion)
MAX_HOPS=1
# Also message on every newly discovered wallet
ALERT_ON_DISCOVERY=false
# Alert on a wallet sending to itself
ALERT_ON_SELF_TRANSFER=false
# Alert on transfers that happened before monitoring started (e.g. found by backfill)
ALERT_ON_HISTORICAL=false

# ------------------------------------------------------------------ Live stream
POLL_INTERVAL_SECONDS=2
# false = fastest (alerts on not-yet-solidified events, ~3 s after the block)
# true  = only irreversible events (~1 minute slower)
REQUIRE_CONFIRMED=false
STREAM_OVERLAP_SECONDS=30

# ------------------------------------------------------------------ Scheduler (safety net)
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_WORKERS=2

# ------------------------------------------------------------------ Backfill
BACKFILL_ENABLED=false
BACKFILL_LOOKBACK_DAYS=30

# ------------------------------------------------------------------ Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_COMMANDS_ENABLED=true
SEND_STARTUP_MESSAGE=true

# ------------------------------------------------------------------ Database
# Docker Compose: only POSTGRES_PASSWORD is needed (DATABASE_URL is set in
# docker-compose.yml).  Use letters/digits only.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Native install (outside Docker):
DATABASE_URL=postgresql://tron:change-me-to-a-long-random-password@localhost:5432/tron_usdt

# ------------------------------------------------------------------ Ops
HEALTH_PORT=8080
HEALTH_MAX_STALL_SECONDS=120
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

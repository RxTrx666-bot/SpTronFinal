# =====================================================================
# TRON address-poisoning monitor - configuration
# Copy to .env and fill in.  Never commit .env.  Secrets are never logged.
# =====================================================================

# ---------------- TRON API (read-only) --------------------------------
# Any TronGrid-compatible full node HTTP API.  Examples:
#   https://api.trongrid.io            (TronGrid, header TRON-PRO-API-KEY)
#   https://<your-provider-endpoint>   (set TRON_API_KEY_HEADER if it differs)
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
TRON_API_KEY_HEADER=TRON-PRO-API-KEY
# Shared request budget for all calls (live polling has priority).  TronGrid
# keys typically allow ~15 rps; keep a margin.
TRON_RATE_LIMIT_RPS=10
TRON_REQUEST_TIMEOUT_SECONDS=15
TRON_MAX_RETRIES=5

# Optional TronScan public tags for "possible exchange/service attribution"
LABELS_ENABLED=true
TRONSCAN_API_KEY=

# ---------------- Token(s) --------------------------------------------
# SYMBOL:CONTRACT:DECIMALS, comma-separated.  Default: official Tether USDT TRC-20.
# NOTE: TLa2f6VPqDgRE67v1736s7bJ8Ray5wYjU7 is NOT the USDT contract (see README).
TOKENS=USDT:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t:6

# ---------------- Monitoring -------------------------------------------
# block   = read every block (constant cost, ~3 s latency, scales to 10k+ wallets)
# account = poll each wallet's history (only for small deployments)
MONITOR_MODE=block
BLOCK_POLL_INTERVAL_SECONDS=0.5
BLOCK_ARRIVAL_MARGIN_MS=600
MAX_BLOCK_CATCHUP=1200
HISTORY_DAYS=0
HISTORY_MAX_TRANSFERS=100000

# ---------------- Network-wide detection --------------------------------
# true  = detect successful poisoning on ANY TRON wallet (every USDT transfer is checked)
# false = only wallets added with /add
NETWORK_WIDE=true
# How long "who paid whom" is remembered for every sender (disk: roughly 1 GB per day of memory)
NETWORK_MEMORY_DAYS=7
# Network-wide alerts only for payments of at least this many USDT
NETWORK_MIN_ALERT_USDT=100

# ---------------- Database ---------------------------------------------
POSTGRES_DB=tron_poison
POSTGRES_USER=tron
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# DATABASE_URL is set by docker-compose; set it yourself when running without Docker:
# DATABASE_URL=postgresql+asyncpg://tron:PASSWORD@localhost:5432/tron_poison

# ---------------- Telegram ---------------------------------------------
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (or a group chat id).  Comma-separate several.
# Only these ids may use commands and buttons.
TELEGRAM_ADMIN_CHAT_ID=
# Optional: deliver alerts to a different chat (defaults to the admin ids)
TELEGRAM_ALERT_CHAT_ID=
NOTIFY_CANDIDATES=true
NOTIFY_ATTEMPTS=false

# ---------------- Detection thresholds ----------------------------------
# Prefix/suffix lengths count characters AFTER the leading "T" (3 = the first 4 characters a wallet shows).
MIN_PREFIX_MATCH=3
MIN_SUFFIX_MATCH=4
SINGLE_EDGE_MIN_MATCH=7
MIN_SIMILARITY_SCORE=0.50
CONFIDENCE_THRESHOLD=80
CANDIDATE_THRESHOLD=50
MIN_LEGIT_TX_COUNT=2
MIN_VICTIM_AMOUNT_USDT=1
DUST_MAX_AMOUNT_USDT=1
# Override individual risk weights (JSON), e.g. {"recipient_new": 25}
RISK_WEIGHTS=

# ---------------- Fund tracing -------------------------------------------
TRACE_ENABLED=true
TRACE_HOPS=5
TRACE_MAX_BRANCHES=3
TRACE_RETRACE_MINUTES=30

# ---------------- X (Twitter) - optional, manual approval only -----------
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---------------- Misc ----------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
SIMULATION_MODE=false
